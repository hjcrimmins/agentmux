#!/usr/bin/env bash
# agentmux: tmux-side state for coding agents. See SPEC.md.
# Must stay compatible with bash 3.2 (macOS /bin/bash). No `set -u`: empty arrays break it on 3.2.

SPEC_VERSION="0.1.0-draft"
TAB=$'\t'
US=$'\x1f'   # unit separator: unlike TAB, IFS does not collapse empty fields

# SPEC §3.3: never break the caller. Errors go to stderr, exit 0 unless AGENTMUX_STRICT=1.
die() {
  echo "agentmux: $*" >&2
  if [ "${AGENTMUX_STRICT:-0}" = 1 ]; then exit 2; fi
  exit 0
}

usage() {
  cat <<'EOF'
usage:
  agentmux set <idle|working|waiting|done> [--reason permission|input] [--msg TEXT|-]
                                           [--harness NAME] [--pid PID] [--pane %N]
  agentmux clear [--pane %N]
  agentmux list [--sort state|name|age]
  agentmux refresh
  agentmux version
EOF
}

# Run several tmux commands in one invocation (applied atomically by the server).
# Usage: tmux_chain cmd1 args... ";" cmd2 args...
tmux_chain() { [ $# -gt 0 ] && tmux "$@"; }

# Append one tmux command to the global array CHAIN, separated by ";".
# tmux treats any argument ending in ";" as a command separator (the ";" is
# dropped) and turns a trailing "\;" into a literal ";". So an argument that
# ends in ";" is sent with that last ";" written as "\;", which tmux stores as
# exactly the original text (e.g. "a;" -> "a\;", "a\;" -> "a\\;", ";" -> "\;").
CHAIN=()
chain_add() {
  local a
  if [ ${#CHAIN[@]} -gt 0 ]; then CHAIN+=(";"); fi
  for a in "$@"; do
    case $a in *';') a="${a%;}\\;" ;; esac
    CHAIN+=("$a")
  done
}

# Unset every per-pane agentmux option on pane $1, appended to CHAIN.
chain_unset_pane() {
  local p=$1 opt
  for opt in @agent_state @agent_reason @agent_harness @agent_msg @agent_pid @agent_ts; do
    chain_add set -pu -t "$p" "$opt"
  done
}

pid_alive() {
  [ -z "$1" ] && return 0              # no pid given -> can't judge, assume alive
  kill -0 "$1" 2>/dev/null && return 0
  ps -p "$1" >/dev/null 2>&1           # kill -0 fails with EPERM for other users' processes
}

# Ask every attached client to redraw its status line.
redraw_status() {
  local c
  tmux list-clients -F '#{client_name}' 2>/dev/null | while IFS= read -r c; do
    tmux refresh-client -S -t "$c" 2>/dev/null
  done
}

# Drop stale entries (dead pid), recompute @agentmux_summary and @agentmux_counts.
cmd_refresh() {
  local w=0 k=0 d=0 i=0 id state pid
  CHAIN=()
  while IFS="$US" read -r id state pid; do
    [ -z "$state" ] && continue
    if ! pid_alive "$pid"; then chain_unset_pane "$id"; continue; fi
    case $state in
      waiting) w=$((w+1)) ;; working) k=$((k+1)) ;; done) d=$((d+1)) ;; idle) i=$((i+1)) ;;
    esac
  done < <(tmux list-panes -a -F "#{pane_id}${US}#{@agent_state}${US}#{@agent_pid}" 2>/dev/null)

  local s=""
  [ $w -gt 0 ] && s="${s}#[fg=red,bold]● ${w} waiting#[default]  "
  [ $k -gt 0 ] && s="${s}#[fg=yellow]… ${k} working#[default]  "
  [ $d -gt 0 ] && s="${s}#[fg=green]✓ ${d} done#[default]  "
  chain_add set -g @agentmux_summary "$s"
  chain_add set -g @agentmux_counts "$w $k $d $i"
  tmux_chain "${CHAIN[@]}"
  redraw_status
}

notify() {  # notify <title> <body>
  [ "$(uname)" = Darwin ] || return 0
  osascript -e 'on run argv' \
            -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"' \
            -e 'end run' "$1" "$2" >/dev/null 2>&1 &
}

cmd_set() {
  local state=$1; shift
  case $state in idle|working|waiting|done) ;; *) die "set: invalid state '$state'" ;; esac

  local reason="" msg="" harness="" pid="" pane="${TMUX_PANE:-}"
  while [ $# -gt 0 ]; do
    case $1 in
      --reason|--msg|--harness|--pid|--pane)
        [ $# -ge 2 ] || die "set: $1 needs a value" ;;
    esac
    case $1 in
      --reason)  reason=$2;  shift 2 ;;
      --msg)     msg=$2;     shift 2 ;;
      --harness) harness=$2; shift 2 ;;
      --pid)     pid=$2;     shift 2 ;;
      --pane)    pane=$2;    shift 2 ;;
      *) die "set: unknown argument '$1'" ;;
    esac
  done
  [ -z "$pane" ] && exit 0                                  # not in tmux: silent no-op
  [[ $pane =~ ^%[0-9]+$ ]] || die "set: invalid pane '$pane'"
  [ -z "$pid" ] || [[ $pid =~ ^[0-9]+$ ]] || die "set: invalid pid '$pid'"
  [[ $harness =~ ^[a-z0-9_.-]*$ ]] || die "set: invalid harness name '$harness'"

  if [ "$state" = waiting ]; then
    [ -z "$reason" ] && reason=input
    case $reason in permission|input) ;; *) die "set: invalid reason '$reason'" ;; esac
  else
    reason=""
  fi

  [ "$msg" = "-" ] && msg=$(cat)
  msg=$(printf '%s' "$msg" | tr '\n\r\t' '   ')
  msg=${msg:0:200}
  msg=${msg//\#/##}                                          # Q-007: neutralise tmux formats

  # Previous state + whether the pane is on screen right now (one round trip).
  local info prev visible where
  info=$(tmux display -p -t "$pane" \
    "#{@agent_state}${US}#{&&:#{pane_active},#{&&:#{window_active},#{session_attached}}}${US}#{session_name}:#{window_name}" 2>/dev/null) \
    || die "set: no such pane '$pane'"
  IFS="$US" read -r prev visible where <<<"$info"

  CHAIN=()
  chain_add set -p -t "$pane" @agent_state   "$state"
  chain_add set -p -t "$pane" @agent_reason  "$reason"
  chain_add set -p -t "$pane" @agent_harness "$harness"
  chain_add set -p -t "$pane" @agent_msg     "$msg"
  chain_add set -p -t "$pane" @agent_pid     "$pid"
  chain_add set -p -t "$pane" @agent_ts      "$(date +%s)"
  tmux_chain "${CHAIN[@]}" || die "set: tmux failed"

  cmd_refresh

  # SPEC §6: notify on transition into waiting/done, unless off or already visible.
  if [ "$prev" != "$state" ] && { [ "$state" = waiting ] || [ "$state" = done ]; } \
     && [ "$visible" != 1 ] \
     && [ "$(tmux show -gv @agentmux_notify 2>/dev/null)" != off ]; then
    local body title
    title="${harness:-agent} · ${where}"
    if [ "$state" = waiting ]; then
      body=${msg//##/#}; [ -z "$body" ] && body="Waiting for ${reason}"
    else
      body="Finished, ready for you"
    fi
    notify "$title" "$body"
  fi
}

cmd_clear() {
  local pane="${TMUX_PANE:-}"
  while [ $# -gt 0 ]; do
    case $1 in
      --pane) [ $# -ge 2 ] || die "clear: $1 needs a value"; pane=$2; shift 2 ;;
      *) die "clear: unknown argument '$1'" ;;
    esac
  done
  [ -z "$pane" ] && exit 0
  [[ $pane =~ ^%[0-9]+$ ]] || die "clear: invalid pane '$pane'"
  CHAIN=(); chain_unset_pane "$pane"
  tmux_chain "${CHAIN[@]}" 2>/dev/null
  cmd_refresh
}

# TSV: pane_id state reason harness location msg age path
cmd_list() {
  local sort=state
  while [ $# -gt 0 ]; do
    case $1 in
      --sort)
        [ $# -ge 2 ] || { echo "agentmux: list: $1 needs a value" >&2; exit 2; }
        sort=$2; shift 2 ;;
      *) echo "agentmux: list: unknown argument '$1'" >&2; exit 2 ;;
    esac
  done
  case $sort in state|name|age) ;; *) echo "agentmux: list: invalid sort '$sort'" >&2; exit 2 ;; esac

  cmd_refresh   # drop stale entries first
  local now; now=$(date +%s)
  tmux list-panes -a -F "#{pane_id}${TAB}#{@agent_state}${TAB}#{@agent_reason}${TAB}#{@agent_harness}${TAB}#{session_name}:#{window_index}.#{pane_index}${TAB}#{@agent_msg}${TAB}#{@agent_ts}${TAB}#{pane_current_path}" \
  | awk -F "$TAB" -v OFS="$TAB" -v now="$now" -v sort="$sort" '
      $2 == "" { next }
      {
        gsub(/##/, "#", $6)                                   # unescape for display
        rank = ($2=="waiting") ? 0 : ($2=="done") ? 1 : ($2=="working") ? 2 : 3
        age = ($7 == "") ? 0 : now - $7
        if (sort == "state") key = sprintf("%d %012d", rank, 999999999999 - age)
        else if (sort == "age") key = sprintf("%012d", age)
        else key = $5
        print key, $1, $2, $3, $4, $5, $6, age, $8
      }' \
  | sort -t "$TAB" -k1,1 \
  | cut -f2-
}

case ${1:-} in
  set)     shift; [ $# -ge 1 ] || die "set: missing state"; cmd_set "$@" ;;
  clear)   shift; cmd_clear "$@" ;;
  list)    shift; cmd_list "$@" ;;
  refresh) shift; cmd_refresh ;;
  version) echo "$SPEC_VERSION" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
exit 0
